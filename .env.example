# dns-mcp environment. Copy to .env (chmod 600). Never commit .env.
# Auth is Pocket ID via CIMD — no admin API key. Both URLs are REQUIRED: the
# server will not start without them.

# Pocket ID issuer (no trailing slash)
POCKET_ID_BASE_URL=https://pocketid.lab.deflationhollow.net

# Public base URL of this server (no /mcp). The resource, and the required
# token aud, is <SERVER_URL>/mcp.
SERVER_URL=https://dns-mcp.lab.deflationhollow.net

# Pocket ID user ids (JWT `sub`) allowed to call tools, comma-separated.
# EMPTY = nobody (fail closed).
ALLOWED_SUBS=
